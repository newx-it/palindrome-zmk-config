if SHIELD_PALINDROME_DONGLE

config ZMK_KEYBOARD_NAME
    default "Palindrome"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 3

config BT_MAX_CONN
    default 3

config BT_MAX_PAIRED
    default 3

endif

if BOARD_PALINDROME_LEFT || BOARD_PALINDROME_RIGHT

config BOARD
    default "palindrome"

config ZMK_SPLIT
    default y

config BT_CTLR
    default BT

if USB_DEVICE_STACK

config USB_NRFX
    default y

endif # USB

endif
